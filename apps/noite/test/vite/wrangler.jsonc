// Vite + @cloudflare/vite-plugin sample (e2e: vite.spec.ts). The build
// writes dist/vite-sample/wrangler.json and .wrangler/deploy/config.json;
// the runner deploys that output, not this file.
{
  "name": "vite-sample",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
}
