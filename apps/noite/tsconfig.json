{
  "extends": "oxidejs/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ilha",
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "oxidejs": ["../../packages/oxidejs/dist/index.d.mts"],
      "oxidejs/client": ["../../packages/oxidejs/client.d.ts"],
      "oxidejs/virtual": ["../../packages/oxidejs/virtual.d.ts"],
      "oxidejs/vite": ["../../packages/oxidejs/dist/vite.d.mts"],
      "oxidejs/wrangler": ["../../packages/oxidejs/dist/wrangler.d.mts"]
    },
    "types": ["vite/client", "oxidejs/client", "oxidejs/virtual"],
    "strictNullChecks": true
  },
  "include": ["src", "vite.config.ts", ".ilha/pages.d.ts"]
}
