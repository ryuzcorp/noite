# Single source for every env var. Copy to `.env`: the Makefile exports it to
# compose (docker/compose.yaml lists every variable with a default), and the
# runner hands the control UI's settings (BETTER_AUTH_*, NOITE_*) to the
# worker, in prod and in `make dev` alike.
BASE_DOMAIN=localhost
# Prod control subdomain: CONTROL_SUBDOMAIN=app (+ BASE_DOMAIN=noite.now).
# Slugs app/api/git are reserved for edge routes.
# Rootless podman cannot bind <1024 — use these defaults.
HTTP_PORT=9080
HTTPS_PORT=9443

RUSTFS_ACCESS_KEY=drilloaccess
RUSTFS_SECRET_KEY=drillosecretdrillosecretdrillo12
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
AWS_REGION=us-east-1

BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
# Prod: generate a real secret (any generator). Values starting `dev-` are
# refused on real domains — the worker fails auth loudly instead of binding
# passkeys to throwaway credentials.
# Lost-passkey sign-in OTP: webhook URL receiving {email, from, otp,
# type} as JSON (workers have no SMTP sockets). Unset = codes print to
# the server log on localhost, hard refusal on a real domain.
# NOITE_EMAIL_WEBHOOK_URL=https://hooks.example.com/noite-otp
# NOITE_SMTP_FROM=Noite <no-reply@noite.now>
# Instance admin: the account with this email is promoted to the admin role
# at startup (sees every user + app under God Mode (`/god-mode`)).
# Register via passkeys first; promotion applies on next boot once set.
# NOITE_ADMIN_EMAIL=you@noite.now
# Control plane origin: bare {BASE_DOMAIN} locally (Bitwarden only accepts
# http://localhost without https), https://app.noite.now in prod.
BETTER_AUTH_URL=http://localhost:9080

# Shared by runner API + Oxide UI server (never expose to the browser).
# Prod: generate a real token — the runner refuses this default off-localhost.
RUNNER_TOKEN=dev-runner-token

# The image `make up-prod` / plain `docker compose up` pulls; `make up`
# builds it from the tree instead. Pin a SHA tag in prod.
# NOITE_IMAGE=ghcr.io/ryuzcorp/noite:latest

# Single rustfs bucket; git/ (tip bundles), fleets/ (tenant celld) and
# control/ (UI worker + its D1) are prefixes under it.
NOITE_S3_BUCKET=noite

# Public Git smart-HTTP base (stock git push; no git-remote-s3 on clients).
GIT_PUBLIC_BASE=http://git.localhost:9080

# Bring your own S3 instead of the bundled RustFS (recommended for real
# installs: R2, Tigris and S3 are the stores celld qualifies). Set these, then
# start without the bundled store: `docker compose -f docker/compose.yaml up
# -d --scale rustfs=0`. Keys need Get/Put/Delete/List on the bucket.
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Bounds. Every app is its own celld fleet on one host, so these are the
# knobs that stop one account (or one busy app) from owning the machine:
#   RUNNER_MAX_APPS_PER_USER  per-account app quota (UI + runner API)
#   RUNNER_FLEET_MAX_RSS_MB celld's CELLD_MAX_RSS_MB for every fleet: when the
#                           container's memory passes it, fleets shed cells
#                           (503 + Retry-After) instead of the container OOM-ing.
#                           Container-wide (fleets share one cgroup), so size it
#                           to the container, never per app; unset/0 = celld's
#                           default, 80% of the container's memory
#   RUNNER_FLEET_IDLE_EVICT_S  idle seconds after which a fleet hibernates
#                           cells and gives memory back (default 120)
#   RUNNER_FLEET_DEPLOY_POLL_S  seconds between a fleet's own polls for new
#                           deployments (default 300): the runner POSTs
#                           /reload after every deploy, so this only covers
#                           a missed reload
#   RUNNER_FLEET_ASSET_CACHE_MB  per-fleet on-disk asset cache in MiB
#                           (default 64, down from celld's 512)
#   RUNNER_OTEL_FLUSH_MS  celld OTel bucket-flush interval in ms, and the
#                           ingest tick cadence (default 30000): dashboards
#                           lag live traffic by up to ~40 s
#   RUNNER_BUILD_CACHE_MB  cap per app on the persistent bun cache in MiB
#                           (default 512, 0 disables persistence)
#   RUNNER_TELEMETRY_RETENTION_DAYS  days of telemetry kept everywhere:
#                           bucket prune, metric tables, glob floor (default 14)
#   RUNNER_TIP_SWEEP_S      fallback S3 tip sweep per app: pushes deploy
#                           immediately over an in-process channel, and this
#                           only covers bundles written behind the runner's
#                           back (another runner, a manual bucket write)
#   RUNNER_SLEEP_AFTER_H    scale to zero: park an app after this many hours
#                           without a request (default 24, 0 = never). The
#                           next request is held at the edge until the fleet
#                           is back up, then served normally (SPEC, Scale to zero)
#   RUNNER_SLEEP_SWEEP_S    how often the sleep sweep runs (default 3600)
#   RUNNER_WAKE_TIMEOUT_S   longest a held request waits for a woken fleet
#                           (default 120; a failed wake answers 503)
#   NOITE_RATE_LIMIT_RPM    public-route limit per client, per class (0 disables)
# RUNNER_MAX_APPS_PER_USER=10
# RUNNER_FLEET_MAX_RSS_MB=0
# RUNNER_FLEET_IDLE_EVICT_S=120
# RUNNER_FLEET_DEPLOY_POLL_S=300
# RUNNER_FLEET_ASSET_CACHE_MB=64
# RUNNER_OTEL_FLUSH_MS=30000
# RUNNER_BUILD_CACHE_MB=512
# RUNNER_TELEMETRY_RETENTION_DAYS=14
# RUNNER_TIP_SWEEP_S=60
# RUNNER_SLEEP_AFTER_H=24
# RUNNER_SLEEP_SWEEP_S=3600
# RUNNER_WAKE_TIMEOUT_S=120
# RUNNER_FLEET_LOG=error,celld=warn
# NOITE_RATE_LIMIT_RPM=600
# NOITE_AUTH_RATE_LIMIT=600

# Extra hostnames serving the control UI (comma-separated) — e.g. Coolify's
# generated domain, `make dev-host` LAN IP. CADDY_AUTO_HTTPS unset = on except
# localhost; `off` behind a terminating proxy (Coolify/Traefik), where our
# Caddy still mints per-host certs on demand.
# CONTROL_EXTRA_HOSTS=
# CADDY_AUTO_HTTPS=off

# Tenancy (SPEC, "Tenancy mode"). Unset = multi off localhost, single on
# localhost. `multi` runs tenant builds and fleets as sandboxed users behind
# an egress policy, and refuses builds when the container lacks the
# capabilities for it (docker/compose.yaml grants them). `single` = only you
# push code to this install.
# NOITE_TENANCY=multi
# Graceful-stop budget: every fleet stops in parallel inside it, then Caddy,
# then the final state snapshot. The platform's stop grace must exceed it.
# NOITE_STOP_BUDGET_MS=25000
# Refuse a build whose worktree grows past this (MiB).
# RUNNER_BUILD_MAX_MB=2048
