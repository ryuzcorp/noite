# Build context bloat guard — docker/Dockerfile.tools builds with context: .
# (repo root). Keep the 2.5 GB cargo target / node_modules / local state out
# of the tar stream. The tools image only needs this file + its own context.

# language build output
target
dist
out

# dependencies
node_modules

# container registry seeds + local state
.wrangler
.celld
data
*.sqlite
*.sqlite-shm
*.sqlite-wal

# vcs / editor
.git
.gitignore
.dockerignore
.idea

# dotenv files MUST use `**/`: a bare name only matches the context root, and
# `apps/noite/.dev.vars` is a real secret file (the UI image build would bake
# its values into the worker bundle's vars block).
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

# plan + docs are repo content — keep markdown out of images to shrink context
# (README is small; SPEC.md is small; both fine to exclude since no image COPYs them)
*.md