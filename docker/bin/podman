#!/bin/sh
# From distrobox/toolbox: never run rootless podman in-process.
# Joining the host userns fails here and deletes a valid pause.pid, wedging
# the host until reboot. Talk to the user podman.socket instead, with a fake
# XDG_RUNTIME_DIR so this client cannot touch the real pause.pid.
set -eu

HOST_PODMAN="${HOST_PODMAN:-/run/host/usr/bin/podman}"
if [ ! -x "$HOST_PODMAN" ]; then
  HOST_PODMAN="$(command -v podman-host 2>/dev/null || true)"
fi
if [ ! -x "${HOST_PODMAN:-}" ] && [ -x /usr/bin/podman ] && [ ! -f /run/.containerenv ]; then
  exec /usr/bin/podman "$@"
fi

if [ ! -f /run/.containerenv ]; then
  exec "$HOST_PODMAN" "$@"
fi

uid="$(id -u)"
SOCK="${PODMAN_SOCK:-/run/user/${uid}/podman/podman.sock}"

ensure_socket() {
  if [ -S "$SOCK" ]; then
    return 0
  fi
  # Start the host user socket without entering the rootless userns here.
  systemd-run --user --wait --collect \
    /bin/bash -c 'systemctl --user enable --now podman.socket' \
    >/dev/null 2>&1 || true
  # Brief wait for the sock to appear in this mount namespace.
  i=0
  while [ "$i" -lt 20 ]; do
    [ -S "$SOCK" ] && return 0
    i=$((i + 1))
    sleep 0.1
  done
  return 1
}

if ! ensure_socket; then
  echo "podman: missing $SOCK" >&2
  echo "on the host run: systemctl --user enable --now podman.socket" >&2
  exit 125
fi

# Isolate client runtime state from the host rootless pause/conmon files.
FAKE="${PODMAN_FAKE_XDG:-/tmp/podman-client-xdg-${uid}}"
mkdir -m 700 -p "$FAKE"
export XDG_RUNTIME_DIR="$FAKE"
export CONTAINER_HOST="unix://${SOCK}"

# Compose provider (podman-compose) needs host Python + libs when invoked
# from the guest; child `podman` calls hit this same wrapper.
export LD_LIBRARY_PATH="/run/host/usr/lib:/run/host/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONPATH="/run/host/usr/lib/python3.14/site-packages${PYTHONPATH:+:$PYTHONPATH}"
# Volume paths on the server use the real host home, not ~/Arch.
export XDG_DATA_HOME="/home/${USER}/.local/share"
export XDG_CONFIG_HOME="/home/${USER}/.config"

exec "$HOST_PODMAN" --remote --url "$CONTAINER_HOST" "$@"
