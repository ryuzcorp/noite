# Tooling image only — app source is bind-mounted at runtime (no rebuild on code change).
# Pinned to the fleet celld (see Dockerfile.runner) so `vite dev` matches
# prod behavior. esbuild/duckdb versions live in docker/install-sidecars.sh.
ARG CELLD_VERSION=0.5.0
FROM ghcr.io/denoland/celld:${CELLD_VERSION} AS celld

FROM docker.io/oven/bun:1.3-debian

ARG TARGETARCH
# Real Node.js: `vite dev` must not run on Bun's node-compat shim
# (`/usr/local/bun-node-fallback-bin/node`) — vite's HMR websocket (the
# `ws` package's upgrade/unexpected-response events) is unimplemented
# there and dev hangs before listening. /usr/local/bin precedes the
# fallback dir on PATH, so this wins automatically.
ARG NODE_VERSION=24.21.0

COPY --from=celld /usr/local/bin/celld /usr/local/bin/celld

COPY docker/install-sidecars.sh /tmp/install-sidecars.sh
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       curl ca-certificates awscli unzip git inotify-tools xz-utils \
  && rm -rf /var/lib/apt/lists/* \
  && sh /tmp/install-sidecars.sh && rm /tmp/install-sidecars.sh \
  && case "${TARGETARCH}" in \
       amd64) NODE_PKG=linux-x64 ;; \
       arm64) NODE_PKG=linux-arm64 ;; \
       *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://nodejs.org/download/release/v${NODE_VERSION}/node-v${NODE_VERSION}-${NODE_PKG}.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
  && celld --version \
  && esbuild --version \
  && node --version | grep -q "^v${NODE_VERSION%%.*}"  # must be real node, not the bun shim

ENV CELLD_ESBUILD=/usr/local/bin/esbuild
WORKDIR /app
