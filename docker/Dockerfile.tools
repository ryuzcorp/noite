# Tooling image only — app source is bind-mounted at runtime (no rebuild on code change).
ARG CELLD_VERSION=0.4.1
FROM ghcr.io/denoland/celld:${CELLD_VERSION} AS celld

FROM docker.io/oven/bun:1.3-debian

ARG TARGETARCH
ARG ESBUILD_VERSION=0.25.12

COPY --from=celld /usr/local/bin/celld /usr/local/bin/celld

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       curl ca-certificates awscli unzip git inotify-tools \
  && rm -rf /var/lib/apt/lists/* \
  && case "${TARGETARCH}" in \
       amd64) ESBUILD_PKG=linux-x64 ;; \
       arm64) ESBUILD_PKG=linux-arm64 ;; \
       *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://registry.npmjs.org/@esbuild/${ESBUILD_PKG}/-/${ESBUILD_PKG}-${ESBUILD_VERSION}.tgz" \
    | tar -xz -C /tmp \
  && install -m 755 /tmp/package/bin/esbuild /usr/local/bin/esbuild \
  && rm -rf /tmp/package \
  && celld --version \
  && esbuild --version

ENV CELLD_ESBUILD=/usr/local/bin/esbuild
WORKDIR /app
