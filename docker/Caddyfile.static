# Noite edge (static): every hostname routes via the control worker.
#
# Topology (container migration): Caddy cannot dial celld container ports —
# they are only reachable through the owning Durable Object — so there are
# no per-tenant upstreams here anymore. All traffic reverse-proxies to
# `control:8090`; the worker Host-dispatches (api./git. → runner :8080,
# {slug}. → fleet port from the route table, apex → control UI) and fetches
# through `RunnerContainer.getTcpPort(port)`.
#
# - `:80` serves plain HTTP (dev `localhost:9080`, ACME challenges, health).
# - `:443` terminates per-hostname TLS with on-demand certs gated by the
#   worker (`ask http://control:8090/v1/edge/tls-ask`, forwarded to the
#   runner). Hostnames the runner does not own — including `localhost` —
#   never mint; dev stays plain HTTP.
# - `auto_https off` is intentional: TLS is explicit per-listener above, so
#   behind-proxy installs (Coolify/Traefik TCP-forwarding SNI) behave the
#   same as direct ones. No CADDY_AUTO_HTTPS templating needed.
{
	auto_https off
	on_demand_tls {
		ask http://control:8090/v1/edge/tls-ask
	}
}

:80, :443 {
	# Shared JSON access log (device breakdown). NOTE: in container mode the
	# runner cannot read this file (no shared volume with celld containers),
	# so device/path/ref aggregates degrade; requests/latency/errors/CPU
	# keep flowing via celld OTel + DuckDB.
	log {
		output file /etc/caddy/access.log
		format json
	}
	tls {
		on_demand
	}
	reverse_proxy control:8090 {
		flush_interval -1
	}
}
