# The celld release Noite patches (denoland/celld ships security fixes only
# from 0.6.x on). Bump both together; `prepare.sh` refuses a tag that moved.
CELLD_VERSION=0.6.3
CELLD_COMMIT=8702f6d186c77698dbfb30cf29e3b1922a88f008
# Increment with every change to patches/: the image is
# ghcr.io/<owner>/celld:<CELLD_VERSION>-noite.<CELLD_PATCH_LEVEL>.
CELLD_PATCH_LEVEL=4
