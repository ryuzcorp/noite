+  constructor(ctx, env) {
+    super(ctx, env);
+    this.writes = [];
+    this.stdinClosed = false;
+    this.carrierText = null;
+    this.signalAborted = null;
+    this.exitCode = 0;
+    this.exitCodeCalls = 0;
+    this.killed = false;
