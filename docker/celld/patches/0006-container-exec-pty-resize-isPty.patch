+fn kill_exec_body(pid: i64, signal: u32) -> Value {
+    json!({
+        "AttachStdin": false, "AttachStdout": false, "AttachStderr": false,
+        "Cmd": ["kill", format!("-{signal}"), pid.to_string()],
