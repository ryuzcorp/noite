From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Noite <noite@noite.now>
Date: Tue, 3 Nov 2026 00:24:09 +0100
Subject: [PATCH] fetch: clone() tees a streaming body and refuses a disturbed
 one

Workerd clones a Response whose body is a stream by teeing it; celld threw "Cannot clone a streaming response before consumption", which breaks the common cache-write shape (clone the response, store one copy, serve the other). Void's ISR does exactly that on its streaming SSR responses, so every ISR page answered 500. Request.clone() already tees; Response.clone() now does the same.

Both clone() paths now also refuse a body that was read through its own reader, even partly, as Fetch and Workerd do: before, a partly read streaming body cloned its remainder and a partly read buffered body cloned all of its bytes. docs/cloudflare-compat.md notes that a cloned platform stream applies backpressure at the slower copy.
---
 crates/celld/js/harness.js | 25 +++++++++++++++++++------
 docs/cloudflare-compat.md  |  6 +++++-
 2 files changed, 24 insertions(+), 7 deletions(-)

diff --git a/crates/celld/js/harness.js b/crates/celld/js/harness.js
index 4b9fcc5..ccbdbb0 100644
--- a/crates/celld/js/harness.js
+++ b/crates/celld/js/harness.js
@@ -1,4 +1,4 @@
-// Modified for Noite (ryuzcorp/noite, docker/celld/patches): ctx.container.images.
+// Modified for Noite (ryuzcorp/noite, docker/celld/patches): ctx.container.images; clone() of streaming and disturbed bodies.
 // The DO object model and the Cloudflare-compatible runtime surface, run
 // once per isolate by `js.rs::install_harness` after the Web-API prelude.
 // Lived as a 4,000-line raw string inside js.rs until 2026-07-29; it is a
@@ -247,6 +247,11 @@ for (const bodyStream of [CelldBodyStream, CelldHttpBodyStream]) {
     value: ReadableStream, writable: true, configurable: true,
   });
 }
+// Fetch's clone() refuses a disturbed or locked body (Workerd too): a body
+// read through its own reader, even partly, cannot be cloned.
+const __bodyDisturbed = (message) => message.bodyUsed ||
+  (message.body != null &&
+    (message.body.locked || message.body._disturbed === true));
 globalThis.Response = class Response {
   constructor(body, init = {}) {
     // Streaming/iterable detection runs only for object bodies, so
@@ -360,11 +365,18 @@ globalThis.Response = class Response {
       { type: this.headers.get("content-type") || "" });
   }
   clone() {
-    if (this.bodyUsed) throw new TypeError("Body has already been consumed");
-    if (this._bodyBytes === null)
-      throw new TypeError("Cannot clone a streaming response before consumption");
+    if (__bodyDisturbed(this))
+      throw new TypeError("Body has already been consumed");
+    // Streaming body: tee, keep one branch, clone the other (as
+    // Request.clone does, and as Workerd does for both).
+    let body = this.body === null ? null : this._bodyBytes;
+    if (this._bodyBytes === null) {
+      const [left, right] = this.body.tee();
+      this.body = left;
+      body = right;
+    }
     const response = new Response(
-      this.body === null ? null : this._bodyBytes,
+      body,
       {
         status: this.status, statusText: this.statusText, headers: this.headers,
         webSocket: this.webSocket, __wsTarget: this._wsTarget, cf: this.cf,
@@ -526,7 +538,8 @@ globalThis.Request = class Request {
       { type: this.headers.get("content-type") || "" });
   }
   clone() {
-    if (this.bodyUsed) throw new TypeError("Body has already been consumed");
+    if (__bodyDisturbed(this))
+      throw new TypeError("Body has already been consumed");
     if (this._bodyBytes === null) {
       // Streaming body: tee, keep one branch, clone the other.
       const [left, right] = this.body.tee();
diff --git a/docs/cloudflare-compat.md b/docs/cloudflare-compat.md
index 46dae05..3daeba4 100644
--- a/docs/cloudflare-compat.md
+++ b/docs/cloudflare-compat.md
@@ -1,4 +1,4 @@
-<!-- Modified for Noite (ryuzcorp/noite, docker/celld/patches): node:crypto scrypt. -->
+<!-- Modified for Noite (ryuzcorp/noite, docker/celld/patches): node:crypto scrypt; cloned streaming bodies. -->
 # Cloudflare compatibility
 
 This page lists only the differences from the linked Cloudflare APIs. An entry
@@ -67,6 +67,10 @@ An unsupported feature that does not cause an error is a defect.
   cannot prove the geolocation, colo, or TLS metadata.
 - celld removes `Content-Length` from a Worker response, except for a `HEAD`
   response.
+- A cloned body that the platform streams (a `fetch()`, RPC, Durable Object
+  or R2 body) applies backpressure at the slower copy: reading only one copy
+  stalls it after 16 chunks until the other copy is read, cancelled, or
+  expires. Workerd buffers for the slower copy instead.
 - A remote Durable Object call cannot retry after request-body transmission
   starts because celld keeps no replay copy.
 - A remote Durable Object call waits for a rejected owner generation to change
