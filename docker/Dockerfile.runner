# syntax=docker/dockerfile:1
# THE runner image: compose `runner` (deploy pipeline, fleet supervisor, route
# table, telemetry aggregation) in every install — local build or GHCR pull.
#
# Repo-root location is load-bearing: `COPY apps/runner/…` inputs are relative
# to the Dockerfile's directory, and CI builds it with the repo root as context.
#
# celld version ARG asserts against docker/Dockerfile.ui, docker/Dockerfile.tools
# and docker/Dockerfile.runner-dev (docker/check-versions.ts).
# Sidecar versions (esbuild/duckdb) live in docker/install-sidecars.sh — bump
# there, not here.
ARG CELLD_VERSION=0.5.1

FROM ghcr.io/denoland/celld:${CELLD_VERSION} AS celld

FROM docker.io/library/rust:1-bookworm AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev \
  && rm -rf /var/lib/apt/lists/*
COPY apps/runner/Cargo.toml apps/runner/Cargo.lock ./
COPY apps/runner/src ./src
# schema.sql is `include_str!`-embedded at compile time: needed to BUILD the
# binary, never shipped as a file.
COPY apps/runner/schema.sql ./schema.sql
RUN cargo build --release && strip target/release/noite-runner

# bun base: the deploy pipeline runs the app's own `bun run build`/release
# scripts. celld binary for tenant fleets; esbuild for `celld deploy`; duckdb
# CLI for telemetry aggregation over the fleet bucket's Parquet spans.
FROM docker.io/oven/bun:1.3-debian
ARG TARGETARCH
COPY docker/install-sidecars.sh /tmp/install-sidecars.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git awscli unzip \
  && rm -rf /var/lib/apt/lists/* \
  && sh /tmp/install-sidecars.sh && rm /tmp/install-sidecars.sh
COPY --from=build /src/target/release/noite-runner /usr/local/bin/noite-runner
COPY --from=celld /usr/local/bin/celld /usr/local/bin/celld
WORKDIR /data
ENV RUNNER_BIND=0.0.0.0:8080 \
    PATH="/usr/local/bin:${PATH}" \
    CELLD_ESBUILD=/usr/local/bin/esbuild
# Runner API (8080) + tenant fleet range (8100+, PORT_BASE stride). celld runs
# in this container so the compose network reaches the tenant listeners
# directly (Caddy proxies runner:81xx); nothing needs publishing on the host.
EXPOSE 8080 8100-8199
# Exec form — never shell — so flags always reach the binary.
ENTRYPOINT ["/usr/local/bin/noite-runner"]
