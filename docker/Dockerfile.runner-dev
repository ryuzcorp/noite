# syntax=docker/dockerfile:1
# Dev runner image: Rust toolchain + celld/bun/aws for cargo-watch rebuilds.
# Sidecar versions (esbuild/duckdb) live in docker/install-sidecars.sh —
# bump there, not here. celld stays an ARG; keep 0.5.1 in sync with
# docker/Dockerfile.runner (0.4.1 stalls binding-created workflows — see SPEC).
ARG CELLD_VERSION=0.5.1
ARG BUN_VERSION=1.3.5

FROM ghcr.io/denoland/celld:${CELLD_VERSION} AS celld

FROM docker.io/library/rust:1-bookworm
ARG TARGETARCH=amd64
ARG BUN_VERSION=1.3.5

COPY docker/install-sidecars.sh /tmp/install-sidecars.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git awscli pkg-config libssl-dev inotify-tools xz-utils unzip \
  && rm -rf /var/lib/apt/lists/* \
  && sh /tmp/install-sidecars.sh && rm /tmp/install-sidecars.sh \
  && case "${TARGETARCH}" in \
       amd64) BUN_ARCH=x64 ;; \
       arm64) BUN_ARCH=aarch64 ;; \
       *) echo "unsupported arch: ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-${BUN_ARCH}.zip" -o /tmp/bun.zip \
  && unzip -q /tmp/bun.zip -d /tmp \
  && install -m 755 /tmp/bun-linux-${BUN_ARCH}/bun /usr/local/bin/bun \
  && rm -rf /tmp/bun.zip /tmp/bun-linux-${BUN_ARCH} \
  && cargo install cargo-watch --locked

COPY --from=celld /usr/local/bin/celld /usr/local/bin/celld

ENV PATH="/usr/local/cargo/bin:/usr/local/bin:${PATH}" \
    CELLD_ESBUILD=/usr/local/bin/esbuild \
    CARGO_TERM_COLOR=always

WORKDIR /src
CMD ["/bin/sh", "/runner-dev.sh"]
