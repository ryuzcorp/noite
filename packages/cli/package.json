{
  "name": "@noitenow/cli",
  "version": "0.1.0-alpha.6",
  "description": "Noite CLI: deploy CI-built dist over Git smart-HTTP (no server build needed)",
  "keywords": [
    "celld",
    "cli",
    "deploy",
    "git",
    "noite",
    "paas",
    "self-hosted"
  ],
  "homepage": "https://github.com/ryuzcorp/noite/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ryuzcorp/noite/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuzcorp/noite.git",
    "directory": "packages/cli"
  },
  "bin": {
    "noite": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/bin.ts --outfile dist/bin.js --target node && chmod +x dist/bin.js",
    "check": "ultracite check",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.4",
    "effect": "^4.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^22.20.4",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5"
}
