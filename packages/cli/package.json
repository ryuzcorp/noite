{
  "name": "@noitenow/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Noite CLI: deploy CI-built dist over Git smart-HTTP (no server build needed)",
  "bin": {
    "noite": "./dist/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "bun build src/bin.ts --outfile dist/bin.js --target bun",
    "check": "ultracite check"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7"
  },
  "packageManager": "bun@1.3.5"
}
