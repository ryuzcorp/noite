{
  "name": "@noitenow/poder",
  "version": "0.1.0",
  "description": "In-pod Cloudflare Workers runtime: D1, R2, KV and Durable Objects on local files for Nodepod preview",
  "keywords": [
    "cloudflare",
    "d1",
    "durable-objects",
    "kv",
    "nodepod",
    "noite",
    "preview",
    "r2",
    "workers"
  ],
  "homepage": "https://github.com/ryuzcorp/noite/tree/main/packages/poder#readme",
  "bugs": {
    "url": "https://github.com/ryuzcorp/noite/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuzcorp/noite.git",
    "directory": "packages/poder"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cloudflare-workers": "./dist/cloudflare-workers.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.mjs --format esm --target node && bun build src/cloudflare-workers.ts --outfile dist/cloudflare-workers.mjs --format esm --target node",
    "check": "ultracite check",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.5"
}
