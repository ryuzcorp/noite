{
  "$schema": "https://schema.railpack.com",
  // Joint control image: Rust runner binary + Bun control UI in one
  // container (Coolify prod). Toolchains come from explicit base images,
  // not autodetection — this repo's pins are load-bearing. esbuild/duckdb
  // versions come from docker/install-sidecars.sh; celld 0.5.0 must mirror
  // docker/Dockerfile.runner (0.4.1 stalls binding-created workflows).
  //
  // Build in CI via the Railpack BuildKit frontend (see images.yml):
  //   railpack prepare --plan-out railpack-plan.json .
  //   docker buildx build --build-arg BUILDKIT_SYNTAX=<frontend> -f railpack-plan.json --push .
  // Validate the plan without building: `railpack plan .`
  "caches": {
    "cargo-registry": {
      "directory": "/usr/local/cargo/registry",
      "type": "shared"
    },
    "cargo-git": {
      "directory": "/usr/local/cargo/git",
      "type": "shared"
    },
    "cargo-target": {
      "directory": "/opt/cargo-target",
      "type": "shared"
    },
    "bun-install": {
      "directory": "/root/.bun/install/cache",
      "type": "shared"
    }
  },
  "steps": {
    "runner": {
      "inputs": [
        { "image": "docker.io/library/rust:1-bookworm" },
        { "local": true, "include": ["apps/runner"] }
      ],
      "caches": ["cargo-registry", "cargo-git", "cargo-target"],
      "commands": [
        "export PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin && export RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo && cd /app/runner && apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev curl ca-certificates && rm -rf /var/lib/apt/lists/* && export CARGO_TARGET_DIR=/opt/cargo-target && cargo build --release && strip /opt/cargo-target/release/noite-runner && install -m 755 /opt/cargo-target/release/noite-runner /usr/local/bin/noite-runner"
      ]
    },
    "ui": {
      "inputs": [
        { "image": "docker.io/oven/bun:1.3-debian" },
        { "local": true, "include": ["apps/noite"] }
      ],
      "caches": ["bun-install"],
      "commands": [
        "export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin && cd /app/noite && bun install --frozen-lockfile && bun run build && bun install --production --frozen-lockfile"
      ]
    },
    "sidecars": {
      "inputs": [
        { "image": "docker.io/library/debian:bookworm-slim" },
        { "local": true, "include": ["docker/install-sidecars.sh"] }
      ],
      "commands": [
        "export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin && apt-get update && apt-get install -y --no-install-recommends curl ca-certificates unzip && rm -rf /var/lib/apt/lists/* && sh /app/docker/install-sidecars.sh"
      ]
    }
  },
  "deploy": {
    "base": { "image": "docker.io/oven/bun:1.3-debian" },
    "aptPackages": ["awscli", "ca-certificates", "curl", "git"],
    "inputs": [
      { "step": "runner", "include": ["/usr/local/bin/noite-runner"] },
      {
        "step": "ui",
        "include": [
          "/app/noite/dist",
          "/app/noite/node_modules",
          "/app/noite/package.json"
        ]
      },
      {
        "step": "sidecars",
        "include": ["/usr/local/bin/esbuild", "/usr/local/bin/duckdb"]
      },
      {
        "image": "ghcr.io/denoland/celld:0.5.0",
        "include": ["/usr/local/bin/celld"]
      },
      { "local": true, "include": ["docker"] }
    ],
    "variables": {
      "RUNNER_BIND": "0.0.0.0:8080",
      "CELLD_ESBUILD": "/usr/local/bin/esbuild"
    },
    "startCommand": "/bin/sh /app/docker/noite-joint.sh"
  }
}
